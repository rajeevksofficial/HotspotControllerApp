<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="4dp">

    <!-- Status badge -->
    <TextView
        android:id="@+id/tvLogStatusBadge"
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_badge_blocked"
        android:gravity="center"
        android:paddingVertical="2dp"
        android:text="BLOCKED"
        android:textColor="@color/status_red"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvLogClientIp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="192.168.43.50"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/tvLogHost"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="tiktok.com"
        android:textColor="@color/text_primary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvLogTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="14:30:12"
        android:textColor="@color/text_muted"
        android:textSize="10sp" />
</LinearLayout>
